# ----------------------------------------------------------------------
# 1. Enforce HTTPS & Canonical Domain (WWW) & Trailing Slash
# ----------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.wandersnepal.com/$1 [R=301,L]

# Force WWW
RewriteCond %{HTTP_HOST} ^wandersnepal\.com$ [NC]
RewriteRule ^(.*)$ https://www.wandersnepal.com/$1 [R=301,L]

# Enforce trailing slash on directories / extensionless URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5})$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://www.wandersnepal.com/$1/ [R=301,L]

# Custom 404 error page
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# 2. Prevent Access to Hidden Files & Version Control (.git)
# ----------------------------------------------------------------------
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

RewriteRule ^\.git - [F,L]
RewriteRule ^__MACOSX - [F,L]

# ----------------------------------------------------------------------
# 3. Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ----------------------------------------------------------------------
# 4. Browser Caching for Performance & Fast Crawling
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 3600 seconds"
  ExpiresByType text/plain "access plus 3600 seconds"
</IfModule>
